{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nbsr.example/schemas/performance-sample-v1.json",
  "title": "NBSR performance sample v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "run_id", "sample_id", "repository_sha", "dirty_tree",
    "environment_digest", "topology", "build_profile", "path",
    "implementation_version", "scenario", "transport_sessions",
    "service_channels", "application_streams", "request_concurrency",
    "payload_bytes", "load_level", "offered_load", "achieved_load",
    "transport_handshake_ns", "hello_rtt_ns", "source_admission_ns",
    "destination_admission_ns", "route_open_rtt_ns", "channel_binding_ns",
    "stream_open_rtt_ns", "ttfab_ns", "request_latency_ns",
    "application_processing_ns", "total_scenario_ns", "success",
    "error_type", "error_stage", "bytes_transmitted", "bytes_received"
  ],
  "properties": {
    "schema": {"const": "nbsr-performance-sample-v1"},
    "run_id": {"type": "string", "minLength": 1},
    "sample_id": {"type": "integer", "minimum": 0},
    "repository_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "dirty_tree": {"type": "boolean"},
    "environment_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "topology": {"const": "windows-loopback"},
    "build_profile": {"const": "release"},
    "path": {"enum": ["direct-quic", "rust-rust", "go-rust"]},
    "implementation_version": {"type": "string", "minLength": 1},
    "scenario": {"enum": ["direct-cold", "direct-warm", "nbsr-cold", "nbsr-warm-new-service", "nbsr-warm-existing-service"]},
    "transport_sessions": {"type": "integer", "minimum": 1},
    "service_channels": {"type": "integer", "minimum": 0},
    "application_streams": {"type": "integer", "minimum": 1},
    "request_concurrency": {"type": "integer", "minimum": 1},
    "payload_bytes": {"enum": [1, 1024, 16384, 262144, 1048576]},
    "load_level": {"type": "string", "minLength": 1},
    "offered_load": {"type": ["number", "null"], "minimum": 0},
    "achieved_load": {"type": ["number", "null"], "minimum": 0},
    "transport_handshake_ns": {"$ref": "#/$defs/duration"},
    "hello_rtt_ns": {"$ref": "#/$defs/duration"},
    "source_admission_ns": {"$ref": "#/$defs/duration"},
    "destination_admission_ns": {"$ref": "#/$defs/duration"},
    "route_open_rtt_ns": {"$ref": "#/$defs/duration"},
    "channel_binding_ns": {"$ref": "#/$defs/duration"},
    "stream_open_rtt_ns": {"$ref": "#/$defs/duration"},
    "ttfab_ns": {"$ref": "#/$defs/duration"},
    "request_latency_ns": {"$ref": "#/$defs/duration"},
    "application_processing_ns": {"$ref": "#/$defs/duration"},
    "total_scenario_ns": {"$ref": "#/$defs/duration"},
    "success": {"type": "boolean"},
    "error_type": {"type": ["string", "null"]},
    "error_stage": {"type": ["string", "null"]},
    "bytes_transmitted": {"type": "integer", "minimum": 0},
    "bytes_received": {"type": "integer", "minimum": 0}
  },
  "$defs": {
    "duration": {"type": ["integer", "null"], "minimum": 0}
  }
}
