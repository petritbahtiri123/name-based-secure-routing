<?xml version="1.0" encoding="utf-8"?>
<WindowsPerformanceRecorder Version="1.0" Author="NBSR">
  <Profiles>
    <EventCollector Id="Task4lAFDCollector" Name="NBSR Task4l AFD">
      <BufferSize Value="64" />
      <Buffers Value="64" />
    </EventCollector>
    <EventProvider Id="Task4lAFDProvider" Name="Microsoft-Windows-Winsock-AFD" Level="4">
      <Keywords><Keyword Value="0x4" /></Keywords>
      <EventFilters FilterIn="true">
        <EventId Value="1000" />
        <EventId Value="1030" />
        <EventId Value="1033" />
      </EventFilters>
    </EventProvider>
    <Profile Id="NBSRTask4lAFD.Verbose.File" Name="NBSRTask4lAFD" Description="Socket identity and datagram drops only" LoggingMode="File" DetailLevel="Verbose">
      <Collectors>
        <EventCollectorId Value="Task4lAFDCollector">
          <EventProviders><EventProviderId Value="Task4lAFDProvider" /></EventProviders>
        </EventCollectorId>
      </Collectors>
    </Profile>
  </Profiles>
</WindowsPerformanceRecorder>
