# Build only after the orchestrator verifies PYTHON_IMAGE is an approved
# python:<version>-slim@sha256:<64 lowercase hex> reference and records it.
# There is deliberately no floating-tag default or invented digest.
ARG PYTHON_IMAGE
FROM ${PYTHON_IMAGE}
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
COPY --chown=65532:65532 deploy/isp-federation-poc/private-origin/main.py /app/main.py
USER 65532:65532
ENTRYPOINT ["python3", "/app/main.py", "--state-dir", "/state"]
