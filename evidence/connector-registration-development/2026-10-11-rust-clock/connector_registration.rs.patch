+#[test]
+fn clock_rollback_cannot_commit_pending_proof() {
+    let (mut g, mut a, mut t) = setup();
+    let proof = pending_proof(&mut g, &mut a, &mut t, request(), 1, 100);
+    let calls = a.calls;
+    assert!(
+        g.handle(
+            1,
+            &env(proof.clone(), 24578, 1, 2),
+            99,
+            Some(&mut a),
+            &mut t
+        )
+        .is_err()
+    );
+    assert!(g.owner.is_none());
+    assert_eq!(a.calls, calls);
+    assert!(
+        g.handle(1, &env(proof, 24578, 1, 3), 100, Some(&mut a), &mut t)
+            .is_err()
+    );
+    assert!(t.closed.is_empty());
+    g.close_attempt(1, &mut t).unwrap();
+    assert_eq!(t.closed, vec![1]);
+}
+
+#[test]
+fn clock_rollback_with_owner_retains_async_cleanup_identity() {
+    let (mut g, mut a, mut t) = setup();
+    complete(&mut g, &mut a, &mut t, request(), 1, 100);
+    g.poll(120, &mut t).unwrap();
+    assert!(g.poll(110, &mut t).is_err());
+    assert!(!g.owner.as_ref().unwrap().eligible);
+    t.fail_close = true;
+    assert!(g.close_attempt(1, &mut t).is_err());
+    assert!(g.owner.is_some());
+    let ticket = g.begin_cleanup(1).unwrap();
+    assert!(g.poll(120, &mut t).is_err());
+    ticket.complete(Ok(()));
+    g.finish_cleanup(&ticket).unwrap();
+    assert!(g.owner.is_none());
+}
+
+#[test]
+fn clock_invalid_sample_cannot_restore_eligibility() {
+    let (mut g, mut a, mut t) = setup();
+    complete(&mut g, &mut a, &mut t, request(), 1, 100);
+    let peer = g.owner.as_ref().unwrap().binding.peer;
+    assert!(g.poll(253402300800, &mut t).is_err());
+    assert!(!g.owner.as_ref().unwrap().eligible);
+    assert!(g.attach(2, [b'x'; 16], peer, 100).is_err());
+    assert!(g.poll(100, &mut t).is_err());
+    assert!(t.closed.is_empty());
+    g.close_attempt(1, &mut t).unwrap();
+    assert!(g.owner.is_none());
+}
+
+#[test]
+fn clock_rollback_at_attach_latches_before_new_connection() {
+    let (mut g, _, mut t) = setup();
+    let peer = bytes(get(map(&request()).unwrap(), 8).unwrap(), 32, false)
+        .unwrap()
+        .try_into()
+        .unwrap();
+    assert!(g.attach(2, [b'x'; 16], peer, 99).is_err());
+    assert!(g.attach(2, [b'x'; 16], peer, 100).is_err());
+    assert!(g.close_attempt(2, &mut t).is_err());
+    g.close_attempt(1, &mut t).unwrap();
+    assert_eq!(t.closed, vec![1]);
+}
