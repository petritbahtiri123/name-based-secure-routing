+// now retains every observed fixture time, including rejected expiry checks.
+// Invalid time latches admission off without pretending cleanup succeeded.
+func (c *Coordinator) now() uint64 {
+	now := c.clock.Now()
+	if now > 253402300799 || (c.hasTime && now < c.lastTime) {
+		c.stopped = true
+		if c.owner != nil {
+			c.owner.Eligible = false
+		}
+		return 253402300800 // Outside every allowed deadline; never a valid time.
+	}
+	c.hasTime, c.lastTime = true, now
+	return now
 }
 
