+func TestObservedOwnerExpiryCannotResurrectAfterClockRollback(t *testing.T) {
+	c, p, clock, _ := fixtureSetup(t)
+	if err := c.Begin(fixtureRequest(t)); err != nil {
+		t.Fatal(err)
+	}
+	old := c.Owner()
+	clock.now = old.Expires
+	if c.Owner().Eligible {
+		t.Fatal("expired owner eligible")
+	}
+	clock.now--
+	if c.Owner().Eligible {
+		t.Fatal("observed expiry resurrected after clock rollback")
+	}
+	b := fixtureRequest(t)
+	b[1], b[14], b[15] = "renew", clock.now, old.Digest[:]
+	before := len(p.seen)
+	if c.Begin(b) == nil || len(p.seen) != before {
+		t.Fatal("expired owner renewed or sent traffic after rollback")
+	}
+	if c.peer == nil || p.closes != 0 {
+		t.Fatal("observing expiry must retain ownership for explicit cleanup")
+	}
+}
