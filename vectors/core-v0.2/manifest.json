      "initial_core_version": 2,
      "steps": [
        {
          "expected_error": null,
          "expected_outcome": "accept",
          "sequence": 1,
          "vector_id": "client-hello"
        },
        {
          "expected_error": null,
          "expected_outcome": "accept",
          "sequence": 2,
          "vector_id": "edge-hello"
        }
      ]
    },
    {
      "final_assertions": [
        "no-route-state",
        "no-stream-state"
      ],
      "id": "no-route-before-admission",
      "initial_core_version": 2,
      "steps": [
        {
          "expected_error": "NBSR_E_ROUTE_DENIED",
          "expected_outcome": "reject",
          "sequence": 1,
          "vector_id": "route-open"
        }
      ]
    },
    {
      "final_assertions": [
        "transport-session-active",
        "no-stream-state"
      ],
      "id": "no-stream-before-route-accept",
      "initial_core_version": 2,
      "steps": [
        {
          "expected_error": null,
          "expected_outcome": "accept",
          "sequence": 1,
          "vector_id": "client-hello"
        },
        {
          "expected_error": null,
          "expected_outcome": "accept",
          "sequence": 2,
          "vector_id": "edge-hello"
        },
        {
          "expected_error": "NBSR_E_ROUTE_DENIED",
          "expected_outcome": "reject",
          "sequence": 3,
          "vector_id": "stream-open"
        }
      ]
    },
    {
      "final_assertions": [
        "transport-session-active",
        "no-route-state",
        "no-stream-state"
      ],
      "id": "rejected-route-leaves-no-state",
      "initial_core_version": 2,
      "steps": [
        {
          "expected_error": null,
          "expected_outcome": "accept",
          "sequence": 1,
          "vector_id": "client-hello"
        },
        {
          "expected_error": null,
          "expected_outcome": "accept",
          "sequence": 2,
          "vector_id": "edge-hello"
        },
        {
          "expected_error": null,
          "expected_outcome": "accept",
          "sequence": 3,
          "vector_id": "route-open"
        },
        {
          "expected_error": null,
          "expected_outcome": "accept",
          "sequence": 4,
          "vector_id": "route-reject"
        }
      ]
    },
    {
      "final_assertions": [
        "replay-state-unchanged",
        "no-route-state"
      ],
      "id": "request-replay-rejected",
      "initial_core_version": 2,
      "steps": [
        {
          "expected_error": null,
          "expected_outcome": "accept",
          "sequence": 1,
          "vector_id": "client-hello"
        },
        {
          "expected_error": "NBSR_E_REPLAY",
          "expected_outcome": "reject",
          "sequence": 2,
          "vector_id": "client-hello"
        }
      ]
    },
    {
      "final_assertions": [
        "no-version-fallback",
        "no-route-state",
        "no-stream-state"
      ],
