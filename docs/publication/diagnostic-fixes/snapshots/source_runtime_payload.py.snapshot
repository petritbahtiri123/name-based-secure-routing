METADATA_PINS = {'.git/config': '74ae643095ffab2050e89814b32b45384b344e1837d99e050a52fb42ede78fe6', '.git/HEAD': '5bcde70a2e7845057ad14c7b262e45bd533ce95deaeddb3a2bda56545b2f17e4', '.git/index': '5f955f9bc7954f493f21cb176c2ca754555ac2240f464d721446570044d8c99b', '.git/shallow': 'b7a159dc11f4629c259d5eb545b5cf9cf2413717abb0c65bb3a75258cbc54c3c'}

def verify_full_presentation(root):
    raw=Path('/nbsr/source-inventory.json').read_bytes()
    assert hashlib.sha256(raw).hexdigest()=='605d132d9734aa9887f80d69cc8dabf62607fb460448c33c95f98fdd978790ff','presentation inventory pin'
    inventory=json.loads(raw);assert inventory['commit']=='47d2ae41df49fedd21768db5fa6be71377acebf3' and len(inventory['files'])==440,'presentation identity'
    return verify_presented_tree(root,inventory['files'])

def verify_presented_tree(root,inventory):
    seen=set();seen_dirs=set();expected_dirs={'.git'}
    for name in inventory:
        expected_dirs.update(p.as_posix() for p in Path(name).parents if str(p)!='.')
    def fail(error):raise error
    for directory,dirs,files in os.walk(root,followlinks=False,onerror=fail):
        parent=Path(directory)
        assert not parent.is_symlink(),'presentation directory alias'
        for name in dirs:
            path=parent/name;relative=path.relative_to(root).as_posix()
            assert relative in expected_dirs and not path.is_symlink(),'presentation directory inventory/alias'
            # The nested original Git mount retains its original filesystem mode.
            if relative!='.git':assert (path.lstat().st_mode & 0o7777)==0o755,'presentation directory mode'
            seen_dirs.add(relative)
        if parent==root and '.git' in dirs:dirs.remove('.git')
        for name in files:
            path=parent/name;relative=path.relative_to(root).as_posix()
            assert relative in inventory,'unexpected presentation file'
            row=inventory[relative];st=path.lstat()
            assert not path.is_symlink() and (st.st_mode & 0o170000)==0o100000,'presentation regular file'
            assert (st.st_mode & 0o7777)==row['mode'] and st.st_size==row['size'],'presentation mode/size'
            assert hashlib.sha256(path.read_bytes()).hexdigest()==row['sha256'],'presentation bytes'
            seen.add(relative)
    assert seen==set(inventory),'presentation completeness'
    assert seen_dirs==expected_dirs,'presentation directory completeness'


def run_probe():
    r=Path('/repo');verify_full_presentation(r); expected_sha='47d2ae41df49fedd21768db5fa6be71377acebf3'
    pin='6ccc7a97451ffc424e1f4f7dfdeb61d125406f35b7962d4cd24d6b3ee735049d'
    assert os.getuid()==65532, 'non-root diagnostic UID required'
    assert r.is_dir() and (r/'.git').is_dir(), 'explicit repository required'
    def checked_bytes(path):
        assert not any(p.is_symlink() or getattr(p.lstat(),'st_file_attributes',0)&0x400 for p in (path,*path.parents)), 'alias/reparse rejected'
        assert path.is_file(), 'regular materialized input required'
        return path.read_bytes()
    b=json.loads(checked_bytes(Path('/nbsr/build.json')))
    assert hashlib.sha256(json.dumps(b,sort_keys=True,separators=(',',':'),allow_nan=False).encode()).hexdigest()==pin, 'manifest pin mismatch'
    assert set(b['binary_sha256'])=={'perf_direct_peer','perf_rust_source','wp8_interop_server'}, 'exact binary inventory'
    for name in b['source_sha256']:
        assert not any(part in ('','.','..') for part in name.split('/')) and ':' not in name and chr(92) not in name, 'source path escape'
    actual_source={name:hashlib.sha256(checked_bytes(r/name)).hexdigest() for name in b['source_sha256']}
    assert actual_source==b['source_sha256'], 'pinned source bytes mismatch'
    hashes={name:hashlib.sha256(checked_bytes(Path('/nbsr/bin')/name)).hexdigest() for name in b['binary_sha256']}
    assert hashes==b['binary_sha256'], 'binary bytes mismatch'
    for name, expected in PYTHON_PINS.items():
        assert hashlib.sha256(checked_bytes(r/name)).hexdigest()==expected, 'Python dependency drift'
    for name, expected in METADATA_PINS.items():
        assert hashlib.sha256(checked_bytes(r/name)).hexdigest()==expected, 'Git metadata drift'
    for name in ('.git/objects/info/alternates','.git/commondir','.git/gitdir'):
        assert not (r/name).exists() and not (r/name).is_symlink(), 'external Git indirection'
    assert not any(k.startswith('GIT_') for k in os.environ), 'unexpected Git environment'
    # Bind project imports to verified source bytes, never sys.path or bytecode.
    roots={name.split('/')[0] for name in PYTHON_PINS}
    assert not any(name.split('.')[0] in roots for name in sys.modules), 'preloaded project module'
    sources={}
    packages=set()
    namespaces=set()
    for filename, expected in PYTHON_PINS.items():
        parts=filename[:-3].split('/')
        if parts[-1]=='__init__':
            parts.pop(); packages.add('.'.join(parts))
        name='.'.join(parts)
        raw=checked_bytes(r/filename)
        assert hashlib.sha256(raw).hexdigest()==expected, 'import source drift'
        sources[name]=(filename,raw)
        namespaces.update('.'.join(parts[:i]) for i in range(1,len(parts)))
    class PinnedLoader(importlib.abc.MetaPathFinder, importlib.abc.Loader):
        def find_spec(self, fullname, path=None, target=None):
            if fullname.split('.')[0] not in roots:return None
            assert fullname in sources or fullname in namespaces, 'unreviewed project import'
            return importlib.util.spec_from_loader(fullname,self,is_package=fullname in packages or fullname not in sources)
        def create_module(self,spec):return None
        def exec_module(self,module):
            name=module.__name__
            if name in sources:
                filename,raw=sources[name]
                module.__file__=str(r/filename)
                exec(compile(raw,module.__file__,'exec'),module.__dict__)
    loader=PinnedLoader()
    sys.meta_path.insert(0,loader)
    try:
        return trusted_probe(r,expected_sha,pin,b,actual_source,hashes,checked_bytes)
    finally:
        sys.meta_path.remove(loader)

def trusted_probe(r,expected_sha,pin,b,actual_source,hashes,checked_bytes):
    from scripts.performance import native_debug_correctness as d
    d.validate_build(b,expected_sha,hashes,pin,actual_source=actual_source)
    env={'PATH':os.environ['PATH'],'GIT_CONFIG_NOSYSTEM':'1','GIT_CONFIG_GLOBAL':'/dev/null'}
    # Proposed third read: preserve source_inventory's tracked-name completeness.
    names=subprocess.check_output(['git','--no-optional-locks','-c','safe.directory=','-c','safe.directory=/repo','-C','/repo','ls-files','-z','--','crates/nbsr-transport/src','crates/nbsr-transport/Cargo.toml','crates/nbsr-transport/Cargo.lock','crates/nbsr-transport/build.rs'],cwd=r,env=env).decode().split(chr(0))
    names=sorted(set(filter(None,names)) | set(d.FIXTURES))
    assert set(names)==set(actual_source), 'tracked source inventory mismatch'
    sha=subprocess.check_output(['git','--no-optional-locks','-c','safe.directory=','-c','safe.directory=/repo','-C','/repo','rev-parse','HEAD'],cwd=r,env=env).decode().strip()
    assert sha==expected_sha, 'HEAD mismatch'
    assert not subprocess.check_output(['git','--no-optional-locks','-c','safe.directory=','-c','safe.directory=/repo','-C','/repo','status','--porcelain','--untracked-files=all'],cwd=r,env=env), 'working tree not clean'
    # Rehash to detect visible changes during the Git reads; this is not atomic.
    current_source={name:hashlib.sha256(checked_bytes(r/name)).hexdigest() for name in names}
    d.validate_build(b,sha,hashes,pin,actual_source=current_source)
    for name, expected in METADATA_PINS.items():
        assert hashlib.sha256(checked_bytes(r/name)).hexdigest()==expected, 'Git metadata changed during reads'
    for name in hashes:assert os.access(Path('/nbsr/bin')/name,os.R_OK|os.X_OK), 'binary access'
    for name in ['linux_native_finite_control','linux_native_finite_endpoint','linux_native_finite_run','linux_native_peer','windows_adopted_campaign']:
        importlib.import_module('scripts.performance.'+name)
    for module in tuple(sys.modules.values()):
        filename=getattr(module,'__file__',None)
        if filename:
            path=Path(filename).resolve()
            if path.is_relative_to(r.resolve()) and path.suffix=='.py':
                name=path.relative_to(r.resolve()).as_posix()
                assert name in PYTHON_PINS, 'unreviewed local import'
                assert hashlib.sha256(checked_bytes(path)).hexdigest()==PYTHON_PINS[name], 'loaded dependency drift'
    for name in ['ca','source','source-key']:
        assert checked_bytes(Path('/private/tls')/(name+'.der'))==b'PUBLIC DIAGNOSTIC DUMMY; NOT TLS MATERIAL\n'
    p=Path('/evidence/probe.txt');p.write_bytes(b'PUBLIC PROBE PASS\n');assert p.stat().st_size<64
    print(json.dumps({'status':'PUBLIC_DIAGNOSTIC_PASS','uid':os.getuid(),'commit':sha,'binary_count':len(hashes),'source_count':len(current_source),'git_read_count':3,'repo_uid':r.stat().st_uid,'git_uid':(r/'.git').stat().st_uid}))

if __name__=='__main__':
    raise SystemExit('GUARDED PROPOSAL: third exact Git read and a new live attempt require approval')
