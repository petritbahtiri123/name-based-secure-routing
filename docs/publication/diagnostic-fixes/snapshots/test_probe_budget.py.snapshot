import ast,json,tempfile,unittest
from pathlib import Path
from test_create_reconciliation import Clock,FakeNative
from diagnostic_probe_budget import DiagnosticCommand
from scripts.performance.local_container_disposal import Unconfirmed
HERE=Path(__file__).resolve().parent
PROBE=next(ast.literal_eval(n.value) for n in ast.walk(ast.parse((HERE/'diagnostic-authorized-attempt-06.py').read_text())) if isinstance(n,ast.Assign) and any(isinstance(t,ast.Name) and t.id=='probe' for t in n.targets))
CID='a'*64
ARGS=['exec',CID,'python3','-B','-c',PROBE]
class ProbeBudget(unittest.TestCase):
 def setUp(self):
  self.temp=tempfile.TemporaryDirectory(dir=HERE);self.addCleanup(self.temp.cleanup)
  self.clock=Clock();self.requests=[];self.backends=[]
 def command(self,delay=10,unreaped=False):
  def factory():
   b=FakeNative(self.clock,dict(delay=delay,unreaped=unreaped,stdout='ok'),self.requests);self.backends.append(b);return b
  return DiagnosticCommand(Path(self.temp.name),started=0,executable='C:/approved/docker.exe',backend_factory=factory,clock=self.clock,sleep=self.clock.sleep)
 def test_default_still_times_out_at_six(self):
  c=self.command()
  with self.assertRaises(Unconfirmed):c(ARGS)
  self.assertAlmostEqual(self.clock(),6);self.assertFalse(c.owner.owned)
 def test_exact_probe_ten_seconds_completes_under_opt_in(self):
  c=self.command();r=c(ARGS,timeout=32,public_probe=True)
  self.assertEqual(r.stdout,'ok');self.assertEqual(self.requests[0]['deadline'],32);self.assertFalse(c.owner.owned)
 def test_opt_in_timeout_reserves_two_seconds(self):
  c=self.command(delay=999)
  with self.assertRaises(Unconfirmed):c(ARGS,timeout=32,public_probe=True)
  self.assertAlmostEqual(self.clock(),30);self.assertFalse(c.owner.owned)
 def test_absolute_work_boundary_is_preserved(self):
  c=self.command(delay=999);self.clock.value=90
  with self.assertRaises(Unconfirmed):c(ARGS,timeout=32,public_probe=True)
  self.assertEqual(self.requests[0]['deadline'],95);self.assertAlmostEqual(self.clock(),93);self.assertFalse(c.owner.owned)
 def test_insufficient_remaining_budget_does_not_spawn(self):
  c=self.command();self.clock.value=93
  with self.assertRaises(TimeoutError):c(ARGS,timeout=32,public_probe=True)
  self.assertEqual(self.requests,[])
 def test_unreaped_ownership_stays_visible(self):
  c=self.command(delay=999,unreaped=True)
  with self.assertRaises(Unconfirmed):c(ARGS,timeout=32,public_probe=True)
  self.assertTrue(c.owner.owned);self.assertAlmostEqual(self.clock(),32)
 def test_opt_in_rejects_other_command_payload_and_cleanup(self):
  c=self.command()
  for args,kw in [(['start',CID],{}),(ARGS[:-1]+['print(1)'],{}),(['exec','bad',*ARGS[2:]],{}),(ARGS,dict(cleanup=True))]:
   with self.assertRaises(ValueError):c(args,timeout=32,public_probe=True,**kw)
  self.assertEqual(self.requests,[])
 def test_extended_budget_requires_explicit_opt_in(self):
  c=self.command()
  with self.assertRaises(ValueError):c(ARGS,timeout=32)
  with self.assertRaises(ValueError):c(ARGS,timeout=33,public_probe=True)
  self.assertEqual(self.requests,[])
class ProposedCaller(unittest.TestCase):
 def test_real_caller_forwards_opt_in_and_remaining_budget(self):
  import types
  tree=ast.parse((HERE/'diagnostic-attempt-07-proposal.py').read_text())
  nodes=[n for n in tree.body if isinstance(n,ast.FunctionDef) and n.name in ['call','success']]
  calls=[];clock=Clock();events=[]
  def command(args,**kw):calls.append((args,kw));return types.SimpleNamespace(code=0,stdout='ok')
  ns=dict(guard=lambda:None,cleaning=False,started=0,time=types.SimpleNamespace(monotonic=clock),command=command,events=events)
  exec(compile(ast.Module(body=nodes,type_ignores=[]),'<isolated actual proposed caller>','exec'),ns)
  self.assertEqual(ns['success'](ARGS,public_probe=True),'ok');self.assertEqual(calls[-1][1],dict(timeout=32,cleanup=False,public_probe=True))
  ns['success'](['inspect',CID]);self.assertEqual(calls[-1][1]['timeout'],8);self.assertFalse(calls[-1][1]['public_probe'])
  clock.value=90;ns['success'](ARGS,public_probe=True);self.assertEqual(calls[-1][1]['timeout'],5)
 def test_proposal_is_guarded_and_payload_unchanged(self):
  tree=ast.parse((HERE/'diagnostic-attempt-07-proposal.py').read_text());self.assertIsInstance(tree.body[0],ast.Raise)
  payload=next(ast.literal_eval(n.value) for n in ast.walk(tree) if isinstance(n,ast.Assign) and any(isinstance(t,ast.Name) and t.id=='probe' for t in n.targets))
  self.assertEqual(payload,PROBE)
  calls=[n for n in ast.walk(tree) if isinstance(n,ast.Call) and any(k.arg=='public_probe' and isinstance(k.value,ast.Constant) and k.value.value is True for k in n.keywords)]
  self.assertEqual(len(calls),1);self.assertEqual(calls[0].func.id,'success')
  self.assertEqual(ast.unparse(calls[0].args[0]), "['exec', cid, 'python3', '-B', '-c', probe]")
if __name__=='__main__':unittest.main()
