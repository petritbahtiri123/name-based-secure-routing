native_finite_control.py\\\': \\\'1c09281b493f474c2799a7bc41b33581799125d2caf38598bf1e16281863d177\\\', \\\'scripts/performance/linux_native_destination_observer.py\\\': \\\'9cf2569900292b138232ceb4995d7e2502228e7fd733514e5c804fd1d3cc5271\\\', \\\'scripts/performance/linux_native_finite_endpoint.py\\\': \\\'f0c5b23723164d490becd207608e6c7e673ff3e149200daf11c45dffdb312390\\\', \\\'scripts/performance/linux_native_lifecycle_remote.py\\\': \\\'3696ac08d635623def597d8cf4eddf7de7b37f173ebe4525988ccc51f1b8a73c\\\', \\\'scripts/performance/linux_native_lifecycle_coordinator.py\\\': \\\'02f284c42b0e2c8a625ac3e5ac4ef31bae32aa645be581608746322258005261\\\', \\\'scripts/performance/linux_native_pair.py\\\': \\\'a41b93109fbdf9bb2e410d18a62cd7143cdc429781140c85c79c2d7aa26021bb\\\', \\\'scripts/performance/linux_native_lifecycle_gate.py\\\': \\\'531dcabefe8389241209615bfc4bfc1081d79bdab7f6b12bd6b037656d70d7d4\\\', \\\'scripts/performance/linux_native_lifecycle_pair.py\\\': \\\'d1ed161049a96429a4282ce43f63399c904af4d0a40789266595636cdf20b0c5\\\', \\\'scripts/performance/linux_native_archive.py\\\': \\\'78ce1ad141daae5d9769aad2e03749f846193a801e068bd6a2425a8a2fb8207e\\\', \\\'scripts/performance/linux_native_lifecycle_run.py\\\': \\\'faa548364c7878f232db74e351fd0820b58bb882ca882dfa81d8131a48d1471e\\\', \\\'scripts/performance/linux_native_live_relay.py\\\': \\\'3fc0c3abda7256dd5a73aa7e022d46ad489d5077605add1ff1fa1e94e0caa40a\\\', \\\'scripts/performance/linux_native_finite_run.py\\\': \\\'ee1e6bd754cb72d6c0df825cd3990f536c466d8520b081c37f1fb60b2dafdcae\\\', \\\'scripts/performance/local_container_disposal.py\\\': \\\'1aa6608bec775e05d272031d536091a54772bb23e1994318bf9d7a66c24a15fc\\\', \\\'scripts/performance/linux_native_watchdog.py\\\': \\\'aa48b3fe060770a224d29641ff471796da866c94cf6ec897865ae56e0821c21a\\\', \\\'scripts/performance/local_container_sequence.py\\\': \\\'d8bb477cd0e5c136b9a2e1339c6b633ed1a8ebb22bb57a43bb1f1fac85e89d83\\\', \\\'scripts/performance/windows_job_backend.py\\\': \\\'dc7c955c3159c4182b98eeb717ce27a9798409542d97f6f5c248afacffd3d1af\\\', \\\'scripts/performance/windows_native_management.py\\\': \\\'e89d236476db0367ea45ac56d643e23ed3cef0eab0344f2e7bbf63689c8892f5\\\', \\\'scripts/performance/windows_docker_provisioning.py\\\': \\\'e22c18ea76a34333f282612e367ff57c12732ffebd8ec2aaaaea86688955aca5\\\', \\\'scripts/performance/windows_adopted_campaign.py\\\': \\\'f52aa9df4fa33906098c24972c395e9c93c2537b6333e888823b7355d0fe633c\\\'}\\nMETADATA_PINS = {\\\'.git/config\\\': \\\'74ae643095ffab2050e89814b32b45384b344e1837d99e050a52fb42ede78fe6\\\', \\\'.git/HEAD\\\': \\\'5bcde70a2e7845057ad14c7b262e45bd533ce95deaeddb3a2bda56545b2f17e4\\\', \\\'.git/index\\\': \\\'5f955f9bc7954f493f21cb176c2ca754555ac2240f464d721446570044d8c99b\\\', \\\'.git/shallow\\\': \\\'b7a159dc11f4629c259d5eb545b5cf9cf2413717abb0c65bb3a75258cbc54c3c\\\'}\\n\\ndef run_probe():\\n    r=Path(\\\'/repo\\\'); expected_sha=\\\'47d2ae41df49fedd21768db5fa6be71377acebf3\\\'\\n    pin=\\\'6ccc7a97451ffc424e1f4f7dfdeb61d125406f35b7962d4cd24d6b3ee735049d\\\'\\n    assert os.getuid()==65532, \\\'non-root diagnostic UID required\\\'\\n    assert r.is_dir() and (r/\\\'.git\\\').is_dir(), \\\'explicit repository required\\\'\\n    def checked_bytes(path):\\n        assert not any(p.is_symlink() or getattr(p.lstat(),\\\'st_file_attributes\\\',0)&0x400 for p in (path,*path.parents)), \\\'alias/reparse rejected\\\'\\n        assert path.is_file(), \\\'regular materialized input required\\\'\\n        return path.read_bytes()\\n    b=json.loads(checked_bytes(Path(\\\'/nbsr/build.json\\\')))\\n    assert hashlib.sha256(json.dumps(b,sort_keys=True,separators=(\\\',\\\',\\\':\\\'),allow_nan=False).encode()).hexdigest()==pin, \\\'manifest pin mismatch\\\'\\n    assert set(b[\\\'binary_sha256\\\'])=={\\\'perf_direct_peer\\\',\\\'perf_rust_source\\\',\\\'wp8_interop_server\\\'}, \\\'exact binary inventory\\\'\\n    for name in b[\\\'source_sha256\\\']:\\n        assert not any(part in (\\\'\\\',\\\'.\\\',\\\'..\\\') for part in name.split(\\\'/\\\')) and \\\':\\\' not in name and chr(92) not in name, \\\'source path escape\\\'\\n    actual_source={name:hashlib.sha256(checked_bytes(r/name)).hexdigest() for name in b[\\\'source_sha256\\\']}\\n    assert actual_source==b[\\\'source_sha256\\\'], \\\'pinned source bytes mismatch\\\'\\n    hashes={name:hashlib.sha256(checked_bytes(Path(\\\'/nbsr/bin\\\')/name)).hexdigest() for name in b[\\\'binary_sha256\\\']}\\n    assert hashes==b[\\\'binary_sha256\\\'], \\\'binary bytes mismatch\\\'\\n    for name, expected in PYTHON_PINS.items():\\n        assert hashlib.sha256(checked_bytes(r/name)).hexdigest()==expected, \\\'Python dependency drift\\\'\\n    for name, expected in METADATA_PINS.items():\\n        assert hashlib.sha256(checked_bytes(r/name)).hexdigest()==expected, \\\'Git metadata drift\\\'\\n    for name in (\\\'.git/objects/info/alternates\\\',\\\'.git/commondir\\\',\\\'.git/gitdir\\\'):\\n        assert not (r/name).exists() and not (r/name).is_symlink(), \\\'external Git indirection\\\'\\n    assert not any(k.startswith(\\\'GIT_\\\') for k in os.environ), \\\'unexpected Git environment\\\'\\n    # Bind project imports to verified source bytes, never sys.path or bytecode.\\n    roots={name.split(\\\'/\\\')[0] for name in PYTHON_PINS}\\n    assert not any(name.split(\\\'.\\\')[0] in roots for name in sys.modules), \\\'preloaded project module\\\'\\n    sources={}\\n    packages=set()\\n    namespaces=set()\\n    for filename, expected in PYTHON_PINS.items():\\n        parts=filename[:-3].split(\\\'/\\\')\\n        if parts[-1]==\\\'__init__\\\':\\n            parts.pop(); packages.add(\\\'.\\\'.join(parts))\\n        name=\\\'.\\\'.join(parts)\\n        raw=checked_bytes(r/filename)\\n        assert hashlib.sha256(raw).hexdigest()==expected, \\\'import source drift\\\'\\n        sources[name]=(filename,raw)\\n        namespaces.update(\\\'.\\\'.join(parts[:i]) for i in range(1,len(parts)))\\n    class PinnedLoader(importlib.abc.MetaPathFinder, importlib.abc.Loader):\\n        def find_spec(self, fullname, path=None, target=None):\\n            if fullname.split(\\\'.\\\')[0] not in roots:return None\\n            assert fullname in sources or fullname in namespaces, \\\'unreviewed project import\\\'\\n            return importlib.util.spec_from_loader(fullname,self,is_package=fullname in packages or fullname not in sources)\\n        def create_module(self,spec):return None\\n        def exec_module(self,module):\\n            name=module.__name__\\n            if name in sources:\\n                filename,raw=sources[name]\\n                module.__file__=str(r/filename)\\n                exec(compile(raw,module.__file__,\\\'exec\\\'),module.__dict__)\\n    loader=PinnedLoader()\\n    sys.meta_path.insert(0,loader)\\n    try:\\n        return trusted_probe(r,expected_sha,pin,b,actual_source,hashes,checked_bytes)\\n    finally:\\n        sys.meta_path.remove(loader)\\n\\ndef trusted_probe(r,expected_sha,pin,b,actual_source,hashes,checked_bytes):\\n    from scripts.performance import native_debug_correctness as d\\n    d.validate_build(b,expected_sha,hashes,pin,actual_source=actual_source)\\n    env={\\\'PATH\\\':os.environ[\\\'PATH\\\'],\\\'GIT_CONFIG_NOSYSTEM\\\':\\\'1\\\',\\\'GIT_CONFIG_GLOBAL\\\':\\\'/dev/null\\\'}\\n    # Proposed third read: preserve source_inventory\\\'s tracked-name completeness.\\n    names=subprocess.check_output([\\\'git\\\',\\\'--no-optional-locks\\\',\\\'-c\\\',\\\'safe.directory=\\\',\\\'-c\\\',\\\'safe.directory=/repo\\\',\\\'-C\\\',\\\'/repo\\\',\\\'ls-files\\\',\\\'-z\\\',\\\'--\\\',\\\'crates/nbsr-transport/src\\\',\\\'crates/nbsr-transport/Cargo.toml\\\',\\\'crates/nbsr-transport/Cargo.lock\\\',\\\'crates/nbsr-transport/build.rs\\\'],cwd=r,env=env).decode().split(chr(0))\\n    names=sorted(set(filter(None,names)) | set(d.FIXTURES))\\n    assert set(names)==set(actual_source), \\\'tracked source inventory mismatch\\\'\\n    sha=subprocess.check_output([\\\'git\\\',\\\'--no-optional-locks\\\',\\\'-c\\\',\\\'safe.directory=\\\',\\\'-c\\\',\\\'safe.directory=/repo\\\',\\\'-C\\\',\\\'/repo\\\',\\\'rev-parse\\\',\\\'HEAD\\\'],cwd=r,env=env).decode().strip()\\n    assert sha==expected_sha, \\\'HEAD mismatch\\\'\\n    assert not subprocess.check_output([\\\'git\\\',\\\'--no-optional-locks\\\',\\\'-c\\\',\\\'safe.directory=\\\',\\\'-c\\\',\\\'safe.directory=/repo\\\',\\\'-C\\\',\\\'/repo\\\',\\\'status\\\',\\\'--porcelain\\\',\\\'--untracked-files=all\\\'],cwd=r,env=env), \\\'working tree not clean\\\'\\n    # Rehash to detect visible changes during the Git reads; this is not atomic.\\n    current_source={name:hashlib.sha256(checked_bytes(r/name)).hexdigest() for name in names}\\n    d.validate_build(b,sha,hashes,pin,actual_source=current_source)\\n    for name, expected in METADATA_PINS.items():\\n        assert hashlib.sha256(checked_bytes(r/name)).hexdigest()==expected, \\\'Git metadata changed during reads\\\'\\n    for name in hashes:assert os.access(Path(\\\'/nbsr/bin\\\')/name,os.R_OK|os.X_OK), \\\'binary access\\\'\\n    for name in [\\\'linux_native_finite_control\\\',\\\'linux_native_finite_endpoint\\\',\\\'linux_native_finite_run\\\',\\\'linux_native_peer\\\',\\\'windows_adopted_campaign\\\']:\\n        importlib.import_module(\\\'scripts.performance.\\\'+name)\\n    for module in tuple(sys.modules.values()):\\n        filename=getattr(module,\\\'__file__\\\',None)\\n        if filename:\\n            path=Path(filename).resolve()\\n            if path.is_relative_to(r.resolve()) and path.suffix==\\\'.py\\\':\\n                name=path.relative_to(r.resolve()).as_posix()\\n                assert name in PYTHON_PINS, \\\'unreviewed local import\\\'\\n                assert hashlib.sha256(checked_bytes(path)).hexdigest()==PYTHON_PINS[name], \\\'loaded dependency drift\\\'\\n    for name in [\\\'ca\\\',\\\'source\\\',\\\'source-key\\\']:\\n        assert checked_bytes(Path(\\\'/private/tls\\\')/(name+\\\'.der\\\'))==b\\\'PUBLIC DIAGNOSTIC DUMMY; NOT TLS MATERIAL\\\\n\\\'\\n    p=Path(\\\'/evidence/probe.txt\\\');p.write_bytes(b\\\'PUBLIC PROBE PASS\\\\n\\\');assert p.stat().st_size<64\\n    print(json.dumps({\\\'status\\\':\\\'PUBLIC_DIAGNOSTIC_PASS\\\',\\\'uid\\\':os.getuid(),\\\'commit\\\':sha,\\\'binary_count\\\':len(hashes),\\\'source_count\\\':len(current_source),\\\'git_read_count\\\':3,\\\'repo_uid\\\':r.stat().st_uid,\\\'git_uid\\\':(r/\\\'.git\\\').stat().st_uid}))\\n\\nif __name__==\\\'__main__\\\':\\n    raise SystemExit(\\\'GUARDED PROPOSAL: third exact Git read and a new live attempt require approval\\\')\\n\',ns);ns[\'run_probe\']()'
 result=success(['exec',cid,'python3','-B','-c',probe],public_probe=True);(ROOT/'probe-result.txt').write_text(result);assert json.loads(result)['status']=='PUBLIC_DIAGNOSTIC_PASS'
except BaseException as e:failure={'type':type(e).__name__,'message':str(e)}
finally:
 cleaning=True
 if reconciler is not None and reconciler.attempted:
  if cid:reconciler.reconcile(allow_running=True)
  # Failed create reconciles immediately inside create(), even without an ID.
  absent=reconciler.state['status']=='REMOVED_EXACT_ID' and not reconciler.state['uncertain']
  cleanup_error=reconciler.state['cleanup_error']
  if reconciler.state['uncertain'] and cleanup_error is None:cleanup_error={'type':'Unconfirmed','message':'daemon-side creation obligation retained; name absence is point-in-time only'}
 owned=command.owner is not None and command.owner.owned
 record={'status':'PASS' if failure is None and cleanup_error is None and absent and not owned else 'FAILED','failure':failure,'cleanup_error':cleanup_error,'container_id':cid,'container_absent':absent,'host_handles_owned':owned,'before':before,'after':resources(),'elapsed':time.monotonic()-started,'events':events,'historical_disk_baseline':14247788544,'growth_limit':300*1024**2,'no_protocol_or_TLS':True,'extended_create':EXTENDED_CREATE,'reconciliation':None if reconciler is None else reconciler.state}
 (ROOT/'result.json').write_text(json.dumps(record,indent=2));print(json.dumps(record))
