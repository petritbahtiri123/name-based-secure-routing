"""Read a cached image through a never-started, mount-free owned container."""
import hashlib,io,json,pathlib,subprocess,time,tarfile,uuid
from source_attempt09_retry1 import resources,FLOOR
P=pathlib.Path(__file__).parent/'debian-closure-plan'
D='C:/Program Files/Docker/Docker/resources/bin/docker.exe'
IMAGE='sha256:ff83a535339812dd72e69c93b3c48ddf7c85a324d6330af5797c82a255dbeef4'
NAME='nbsr-debian-metadata-'+uuid.uuid4().hex[:12]
started=time.monotonic();before=resources();cleaning=False;attempted=False;cid=None
result={'name':NAME,'image':IMAGE,'started_containers':0,'mounts':0,'files':{}}
def run(args,check=True):
    elapsed=time.monotonic()-started
    if elapsed>(110 if cleaning else 60):raise TimeoutError('phase deadline')
    if not cleaning:
        r=resources()
        assert r['disk']>=FLOOR and before['disk']-r['disk']<=300*1024**2 and min(r['ram'],r['commit'])>=2*1024**3
    proc=subprocess.Popen([D]+args,stdout=subprocess.PIPE,stderr=subprocess.PIPE)
    try:out,err=proc.communicate(timeout=min(12,115-elapsed))
    except subprocess.TimeoutExpired:
        subprocess.run(['taskkill','/PID',str(proc.pid),'/T','/F'],capture_output=True,timeout=5)
        out,err=proc.communicate(timeout=3)
        raise TimeoutError('Docker command timeout: '+args[0])
    with (P/'docker-metadata-log.jsonl').open('a') as log:log.write(json.dumps({'args':args,'returncode':proc.returncode,'stderr':err.decode(errors='replace')})+'\n')
    if check and proc.returncode:raise RuntimeError(err.decode(errors='replace'))
    return proc.returncode,out,err
try:
    assert before['disk']>=FLOOR+500*1024**2 and min(before['ram'],before['commit'])>=2*1024**3
    attempted=True
    _,out,_=run(['create','--pull=never','--name',NAME,'--label','nbsr.role=debian-metadata','--network','none','--user','65532:65532','--read-only','--cap-drop','ALL','--security-opt','no-new-privileges','--memory','512m','--memory-swap','512m','--cpus','1','--pids-limit','128','--entrypoint','/bin/true',IMAGE])
    cid=out.decode().strip()
    _,out,_=run(['inspect','--format','{{json .}}',cid]);row=json.loads(out)
    assert row['Image']==IMAGE and row['Mounts']==[] and row['State']['Status']=='created' and not row['State']['Running']
    assert row['Config']['User']=='65532:65532' and row['HostConfig']['NetworkMode']=='none'
    (P/'base-container-inspect.json').write_text(json.dumps(row,indent=2))
    for src,dst in [('/usr/lib/os-release','os-release'),('/var/lib/dpkg/status','dpkg-status'),('/usr/share/keyrings/debian-archive-keyring.gpg','debian-archive-keyring.gpg'),('/etc/apt/sources.list.d/debian.sources','debian.sources')]:
        _,out,_=run(['cp',cid+':'+src,'-']);assert len(out)<4*1024**2
        with tarfile.open(fileobj=io.BytesIO(out)) as tf:
            members=tf.getmembers();assert len(members)==1 and members[0].isfile()
            data=tf.extractfile(members[0]).read()
        (P/dst).write_bytes(data);result['files'][dst]={'bytes':len(data),'sha256':hashlib.sha256(data).hexdigest()}
    result['status']='METADATA_COPIED'
except BaseException as e:result['status']='FAILED';result['error']=str(e)
finally:
    cleaning=True
    try:
        if attempted:
            code,out,err=run(['inspect','--format','{{json .}}',NAME],False)
            if code==0:
                row=json.loads(out);assert row['Image']==IMAGE and row['Config']['Labels'].get('nbsr.role')=='debian-metadata' and row['Name']=='/'+NAME and not row['State']['Running']
                run(['rm',row['Id']])
            elif b'No such' not in err:raise RuntimeError('ambiguous inspect')
            code,out,err=run(['inspect',NAME],False);assert code!=0 and b'No such' in err
        result['container_absent']=True
    except BaseException as e:result['container_absent']=False;result['cleanup_error']=str(e)
    result.update(elapsed=time.monotonic()-started,before=before,after=resources())
    (P/'base-metadata-result.json').write_text(json.dumps(result,indent=2));print(json.dumps(result))
if result['status']!='METADATA_COPIED' or not result['container_absent']:raise SystemExit(1)
