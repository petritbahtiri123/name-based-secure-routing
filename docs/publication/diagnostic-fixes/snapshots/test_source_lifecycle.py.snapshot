import json,tempfile,unittest
from pathlib import Path
from types import SimpleNamespace
from diagnostic_source_lifecycle import SourceVolume,NAME
from scripts.performance.local_container_disposal import Unconfirmed
HERE=Path(__file__).parent
class Fake:
    def __init__(self):self.responses=[];self.calls=[];self.owner=None
    def __call__(self,args,**kwargs):
        self.calls.append((args,kwargs));result=self.responses.pop(0)
        if isinstance(result,BaseException):raise result
        return SimpleNamespace(code=0,stdout=result)
class Lifecycle(unittest.TestCase):
    def setUp(self):
        self.temp=tempfile.TemporaryDirectory(dir=HERE,prefix='nbsr-source-lifecycle-test-')
        assert Path(self.temp.name).resolve().parent==HERE.resolve()
        self.addCleanup(self.temp.cleanup);self.command=Fake();self.volume=SourceVolume(self.temp.name,self.command,'test-nonce')
        self.row={'Name':NAME,'Driver':'local','Scope':'local','Labels':self.volume.labels,'Options':None,'CreatedAt':'2026-10-15T00:00:00Z','Mountpoint':'/var/lib/docker/volumes/'+NAME+'/_data'}
    def create(self):
        self.command.responses=['',NAME,json.dumps(self.row)];self.volume.create()
    def test_success_exact_nonforce_cleanup(self):
        self.create();self.command.responses=[json.dumps(self.row),'',NAME,'']
        self.assertTrue(self.volume.cleanup(containers_absent=True));self.assertFalse(self.volume.state['uncertain'])
        self.assertEqual(self.command.calls[-2][0],['volume','rm',NAME])
        self.assertTrue(all(k['cleanup'] for a,k in self.command.calls[-4:]))
    def test_preexisting_volume_untouched(self):
        self.command.responses=[NAME]
        with self.assertRaises(Unconfirmed):self.volume.create()
        self.assertFalse(self.volume.state['attempted']);self.assertEqual(len(self.command.calls),1)
    def test_create_timeout_keeps_obligation_and_never_removes(self):
        self.command.responses=['',TimeoutError('injected uncertain create')]
        with self.assertRaises(TimeoutError):self.volume.create()
        self.assertFalse(self.volume.cleanup(containers_absent=True));self.assertTrue(self.volume.state['uncertain'])
        self.assertEqual(len(self.command.calls),2)
    def test_changed_volume_blocks_removal(self):
        self.create();self.command.responses=[json.dumps({**self.row,'CreatedAt':'changed'})]
        self.assertFalse(self.volume.cleanup(containers_absent=True));self.assertEqual(self.command.calls[-1][0][:2],['volume','inspect'])
    def test_container_uncertainty_blocks_even_inspection(self):
        self.create();count=len(self.command.calls)
        self.assertFalse(self.volume.cleanup(containers_absent=False));self.assertEqual(len(self.command.calls),count)
    def test_unexpected_user_blocks_nonforce_removal(self):
        self.create();self.command.responses=[json.dumps(self.row),'b'*64]
        self.assertFalse(self.volume.cleanup(containers_absent=True));self.assertEqual(self.command.calls[-1][0][0],'ps')
    def test_removal_without_absence_stays_uncertain(self):
        self.create();self.command.responses=[json.dumps(self.row),'',NAME,NAME]
        self.assertFalse(self.volume.cleanup(containers_absent=True));self.assertTrue(self.volume.state['uncertain'])
    def test_retry_forbidden(self):
        self.create()
        with self.assertRaises(Unconfirmed):self.volume.create()
    def test_bad_ack_never_establishes_ownership(self):
        self.command.responses=['','wrong']
        with self.assertRaises(Unconfirmed):self.volume.create()
        self.assertIsNone(self.volume.state['snapshot']);self.assertFalse(self.volume.cleanup(containers_absent=True))
if __name__=='__main__':unittest.main()
