import ast,unittest,subprocess
from pathlib import Path
import tls_prepare_payload as p
class Gates(unittest.TestCase):
 def test_missing_cgroup_rejected_before_any_loader(self):
  self.assertTrue(hasattr(p,'prerequisites'),'prerequisite gate missing')
  with self.assertRaises(ValueError):p.prerequisites({'cgroup_observed':{'cpu.max':{'status':'UNAVAILABLE'}}},run=lambda *a,**k:self.fail('loader before gate'))
 def test_unresolved_dependency_fails_before_authority(self):
  self.assertTrue(hasattr(p,'prerequisites'),'prerequisite gate missing')
  env={'cgroup_observed':{'/sys/fs/cgroup/'+n:'1' for n in ('cpu.max','cpu.stat','cpuset.cpus.effective','memory.max','pids.max')},'proc_cgroup':'0::/','proc_mountinfo':'mount'}
  def fail(*a,**kw):raise subprocess.CalledProcessError(1,a)
  with self.assertRaises(subprocess.CalledProcessError):p.prerequisites(env,run=fail)
  tree=ast.parse(Path(p.__file__).read_text());fn=next(n for n in tree.body if isinstance(n,ast.FunctionDef) and n.name=='prepare');text=ast.unparse(fn)
  self.assertLess(text.index('prerequisites('),text.index('write_loopback_authority'))
if __name__=='__main__':unittest.main()
