import ast,hashlib,json,unittest
from pathlib import Path
from unittest.mock import patch
import test_probe_call_chain as harness
HERE=Path(__file__).resolve().parent
class Reporting(unittest.TestCase):
 def helper(self):
  tree=ast.parse((HERE/'public-probe-status-candidate.py').read_text());node=next(n for n in tree.body if isinstance(n,ast.FunctionDef) and n.name=='require_clean_status')
  ns=dict(hashlib=hashlib,json=json);exec(compile(ast.Module(body=[node],type_ignores=[]),'<reporter>','exec'),ns);return ns['require_clean_status']
 def test_clean(self):self.helper()(b'')
 def test_dirty_includes_status_and_rejects(self):
  value=b' M scripts/example.py\n?? unexpected\n'
  with self.assertRaises(AssertionError) as e:self.helper()(value)
  report=json.loads(str(e.exception).split(': ',1)[1]);self.assertEqual(report['status_preview'],value.decode());self.assertFalse(report['truncated']);self.assertEqual(report['sha256'],hashlib.sha256(value).hexdigest())
 def test_bounded_and_escaped(self):
  value=b' M '+bytes([255,10,27])+b'x'*20000
  with self.assertRaises(AssertionError) as e:self.helper()(value)
  text=str(e.exception);report=json.loads(text.split(': ',1)[1]);self.assertTrue(report['truncated']);self.assertEqual(report['bytes'],len(value));self.assertLess(len(text),26000);self.assertNotIn(chr(27),text)
class Integration(unittest.TestCase):
 def execute(self,fault=None):
  source=(HERE/'public-probe-status-candidate.py').read_text();original=Path.read_text
  def read(path,*a,**kw):return source if path==HERE/'public-probe-candidate.py' else original(path,*a,**kw)
  case=harness.ProbeTests()
  with patch.object(Path,'read_text',read):case.execute(fault)
  return case
 def test_clean_full_probe_same_three_reads(self):
  case=self.execute();self.assertEqual([a for a,k in case.calls],harness.COMMANDS);self.assertEqual(case.wrote,b'PUBLIC PROBE PASS\n')
 def test_dirty_full_probe_still_rejects_with_paths(self):
  with self.assertRaisesRegex(AssertionError,'unexpected'):self.execute('dirty')
if __name__=='__main__':unittest.main()
