from scripts.performance.windows_job_backend import Win32Backend, W
class IdentityBackend(Win32Backend):
 def create_suspended(self,args):
  handles=super().create_suspended(args)
  try:
   self.kernel.GetProcessId.argtypes=[W.HANDLE]; self.kernel.GetProcessId.restype=W.DWORD
   result.setdefault('helper_identities',[]).append(dict(time=time.monotonic(),pid=self.kernel.GetProcessId(handles[0]),process_handle=handles[0],thread_handle=handles[1]))
  except Exception as e:
   result.setdefault('identity_errors',[]).append(type(e).__name__)
  return handles
command=DockerCommand(OUT,executable=argv[0],backend_factory=IdentityBackend,max_timeout=32); started=time.monotonic(); cid=None

def call(args,stage,cleanup=False):
 remaining=(118 if cleanup else 95)-(time.monotonic()-started)
 if remaining<=0: raise TimeoutError('original total deadline')
 if not cleanup: guard.resources()
 r=command(args,timeout=min(32 if stage=='create' else (17 if stage=='wait_metadata' else 8),remaining))
 result['events'].append(dict(stage=stage,code=r.code,stdout=r.stdout,stderr=r.stderr,elapsed=time.monotonic()-started))
 return r

def absent(r,identity):
 return r.code==1 and not r.stdout.strip() and r.stderr.strip().lower() in tuple(prefix+identity for prefix in ['error: no such container: ','error: no such object: ','error response from daemon: no such container: '])

try:
 r=call(argv[1:],'create')
 if r.code!=0 or not re.fullmatch('[0-9a-f]{64}',r.stdout.strip()): raise RuntimeError('create failed or returned no exact ID')
 cid=r.stdout.strip(); result['status']='CREATED_STOPPED'
 fmt='{"Id":{{json .Id}},"Image":{{json .Image}},"Labels":{{json .Config.Labels}},"HostConfig":{{json .HostConfig}},"Mounts":{{json .Mounts}},"Running":{{json .State.Running}}}'
 v=call(['inspect','--type','container','--format',fmt,cid],'verify_isolation')
 if v.code:raise RuntimeError('isolation inspect failed')
 row=json.loads(v.stdout);h=row['HostConfig']
 expected=dict(NetworkMode='none',ReadonlyRootfs=True,CapDrop=['ALL'],SecurityOpt=['no-new-privileges'],PidsLimit=64,NanoCpus=1000000000,Memory=536870912,MemorySwap=536870912,Privileged=False)
 if row['Id']!=cid or row['Image']!='sha256:7d59795425e21fc5ff09eabea1aad314806e8f20d3a505c5e47cc2df0e20e53d' or row['Labels'].get('nbsr.prerequisite')!=LABEL.split('=',1)[1] or len(row['Mounts'])!=1 or row['Mounts'][0]['Type']!='bind' or row['Mounts'][0]['Destination']!='/inspection/Cargo.lock' or row['Mounts'][0]['RW'] is not False or Path(row['Mounts'][0]['Source']).resolve()!=LOCK.resolve() or row['Running'] is not False or any(h.get(k)!=v for k,v in expected.items()) or h.get('PortBindings'):raise RuntimeError('isolation mismatch')
 result['isolation_verified']=True
 v=call(['start',cid],'start_metadata')
 if v.code:raise RuntimeError('start failed')
 v=call(['wait',cid],'wait_metadata')
 if v.code or v.stdout.strip()!='0':raise RuntimeError('metadata exit failure')
 v=call(['logs',cid],'read_metadata')
 if v.code:raise RuntimeError('metadata logs failed')
 result['metadata_text']=v.stdout;result['status']='METADATA_OBSERVED'
except BaseException as e: result.update(status='BLOCKED',primary_error=dict(type=type(e).__name__,message=str(e)))
finally:
 result['created_id']=cid
 try:
  if command.owner is not None and command.owner.owned: raise RuntimeError('command handles retained; cannot confirm cleanup through this owner')
  fmt='{"Id":{{json .Id}},"Image":{{json .Image}},"Labels":{{json .Config.Labels}},"Running":{{json .State.Running}}}'
  r=call(['inspect','--type','container','--format',fmt,cid or NAME],'identify_owned_container',True)
  if absent(r,cid or NAME): result['cleanup']='ABSENT_AT_OBSERVATION'
  elif r.code==0:
   row=json.loads(r.stdout); identity=row['Id']
   if not re.fullmatch('[0-9a-f]{64}',identity) or (cid and cid!=identity) or row['Image']!='sha256:7d59795425e21fc5ff09eabea1aad314806e8f20d3a505c5e47cc2df0e20e53d' or row['Labels'].get('nbsr.prerequisite')!=LABEL.split('=',1)[1]: raise RuntimeError('ownership identity mismatch')
   result['identified_id']=identity; result['observed_running']=row['Running']
   r=call(['rm','--force',identity],'remove_exact_id',True)
   if r.code: raise RuntimeError('removal failed')
   r=call(['inspect','--type','container','--format','{{.Id}}',identity],'independent_absence',True)
   if not absent(r,identity): raise RuntimeError('absence unconfirmed')
   result['cleanup']='EXACT_ID_REMOVED_AND_ABSENT'
  else: raise RuntimeError('identity/absence query failed')
 except BaseException as e: result['cleanup_error']=dict(type=type(e).__name__,message=str(e))
 result['elapsed_seconds']=time.monotonic()-started; result['command_owned']=None if command.owner is None else command.owner.owned
 try: result['resources_end']=guard.resources()
 except BaseException as e: result['resource_error']=str(e)
 (OUT/'result.json').write_text(json.dumps(result,indent=2)); print(json.dumps(result))
