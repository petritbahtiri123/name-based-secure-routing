 fmt='{"Id":{{json .Id}},"Image":{{json .Image}},"Labels":{{json .Config.Labels}},"HostConfig":{{json .HostConfig}},"Mounts":{{json .Mounts}},"Running":{{json .State.Running}}}'
 v=call(['inspect','--type','container','--format',fmt,cid],'verify_isolation')
 if v.code:raise RuntimeError('isolation inspect failed')
 row=json.loads(v.stdout);h=row['HostConfig']
 expected=dict(NetworkMode='none',ReadonlyRootfs=True,CapDrop=['ALL'],SecurityOpt=['no-new-privileges'],PidsLimit=64,NanoCpus=1000000000,Memory=536870912,MemorySwap=536870912,Privileged=False)
 if row['Id']!=cid or row['Image']!='sha256:7d59795425e21fc5ff09eabea1aad314806e8f20d3a505c5e47cc2df0e20e53d' or row['Labels'].get('nbsr.prerequisite')!=LABEL.split('=',1)[1] or len(row['Mounts'])!=1 or row['Mounts'][0]['Type']!='bind' or row['Mounts'][0]['Destination']!='/inspection/Cargo.lock' or row['Mounts'][0]['RW'] is not False or Path(row['Mounts'][0]['Source']).resolve()!=LOCK.resolve() or row['Running'] is not False or any(h.get(k)!=v for k,v in expected.items()) or h.get('PortBindings'):raise RuntimeError('isolation mismatch')
 result['isolation_verified']=True
 v=call(['start',cid],'start_metadata')
 if v.code:raise RuntimeError('start failed')
 v=call(['wait',cid],'wait_metadata')
 if v.code or v.stdout.strip()!='0':raise RuntimeError('metadata exit failure')
 v=call(['logs',cid],'read_metadata')
 if v.code:raise RuntimeError('metadata logs failed')
 result['metadata_text']=v.stdout;result['status']='METADATA_OBSERVED'
except BaseException as e: result.update(status='BLOCKED',primary_error=dict(type=type(e).__name__,message=str(e)))
finally:
