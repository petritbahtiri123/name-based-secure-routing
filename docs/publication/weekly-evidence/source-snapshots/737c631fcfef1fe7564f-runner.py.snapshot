from scripts.performance.windows_job_backend import Win32Backend, W
class IdentityBackend(Win32Backend):
 def create_suspended(self,args):
  handles=super().create_suspended(args)
  try:
   self.kernel.GetProcessId.argtypes=[W.HANDLE]; self.kernel.GetProcessId.restype=W.DWORD
   result.setdefault('helper_identities',[]).append(dict(time=time.monotonic(),pid=self.kernel.GetProcessId(handles[0]),process_handle=handles[0],thread_handle=handles[1]))
  except Exception as e:
   result.setdefault('identity_errors',[]).append(type(e).__name__)
  return handles
command=DockerCommand(OUT,executable=argv[0],backend_factory=IdentityBackend,max_timeout=32); started=time.monotonic(); cid=None

def call(args,stage,cleanup=False):
 remaining=(118 if cleanup else 95)-(time.monotonic()-started)
 if remaining<=0: raise TimeoutError('original total deadline')
 if not cleanup: guard.resources()
 r=command(args,timeout=min(32 if stage=='create' else (17 if stage=='wait_metadata' else 8),remaining))
 result['events'].append(dict(stage=stage,code=r.code,stdout=r.stdout,stderr=r.stderr,elapsed=time.monotonic()-started))
 return r

def absent(r,identity):
 return r.code==1 and not r.stdout.strip() and r.stderr.strip().lower() in tuple(prefix+identity for prefix in ['error: no such container: ','error: no such object: ','error response from daemon: no such container: '])

