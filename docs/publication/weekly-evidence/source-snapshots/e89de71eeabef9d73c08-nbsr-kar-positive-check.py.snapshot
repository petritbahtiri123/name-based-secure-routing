# Enforce the original aggregate baseline throughout each supervised run.
_original_disk_usage = b.shutil.disk_usage
def cumulative_disk_usage(path):
    value = _original_disk_usage(path)
    if 14247788544 - value.free > 2*2**30:
        return value._replace(free=0)
    return value
b.shutil.disk_usage = cumulative_disk_usage
b.SOURCE=here/'nbsr-publication-validation-20261011';b.ROOT=here/'nbsr-kar-positive-20261012';b.EVIDENCE=here/'nbsr-kar-positive-evidence-20261012';b.SHA='ad77d59754651fee449bb1d9c14a946f9f3b2d15'
